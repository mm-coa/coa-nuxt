{
  "name": "mm-coa-nuxt",
  "version": "1.0.0",
  "description": "project basic faramework for nuxt",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsc -w",
    "build": "rm -rf dist* && tsc && cp package.json *.md dist",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "yarn run typecheck && yarn run format:check",
    "validate": "yarn run lint",
    "check": "yarn run lint",
    "prettier": "yarn format",
    "sync": "curl -X PUT 'https://registry.npmmirror.com/mm-coa-nuxt/sync?publish=false&nodeps=false'"
  },
  "dependencies": {
    "@types/lodash": "^4.17.24",
    "dayjs": "^1.11.21",
    "lodash": "^4.18.1"
  },
  "peerDependencies": {
    "nuxt": "4.4.8"
  },
  "devDependencies": {
    "nuxt": "4.4.8",
    "prettier": "^3.9.4",
    "typescript": "^5.9.3"
  }
}
